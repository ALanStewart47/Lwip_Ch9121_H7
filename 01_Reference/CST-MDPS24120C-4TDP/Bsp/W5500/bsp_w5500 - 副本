/**
 * @brief  临时函数 ，用于 保存IP,SN,GW，等信息
 * 
 * @Note   devname 不需要使用
 * 
 * */
void bsp_save_new_ip(void)
{
	uint64_t TEMP_buff1[3];
	
	TEMP_buff1[0] = (((uint64_t)FLASH_CHECK_NUMMBER_1>>0))+(((uint64_t)FLASH_CHECK_NUMMBER_2<<8));
	
	TEMP_buff1[1] = ((ip[0]>>0) )+(((uint64_t)ip[1]<<8) )+								//ip
									(((uint64_t)ip[2]<<16) )+(((uint64_t)ip[3]<<24) )+   
									(((uint64_t)sn[0]<<32) )+(((uint64_t)sn[1]<<40) )+		//sn
									(((uint64_t)sn[2]<<48) )+(((uint64_t)sn[3]<<56));
	
	TEMP_buff1[2] = ((gw[0]<<0) ) +(((uint64_t)gw[1]<<8) )+(((uint64_t)gw[2]<<16) )+(((uint64_t)gw[3]<<24) )+  //gw
									(((uint64_t)g_dhcp_state<<32) );		//dhcp
    
	bsp_flash_erase(ADDR_FLASH_PAGE_62);
	
	HAL_FLASH_Unlock();
	
	HAL_FLASH_Program(FLASH_TYPEPROGRAM_DOUBLEWORD,ADDR_FLASH_PAGE_62,TEMP_buff1[0]);
	
	HAL_FLASH_Program(FLASH_TYPEPROGRAM_DOUBLEWORD,ADDR_FLASH_PAGE_62+8,TEMP_buff1[1]);
	
	HAL_FLASH_Program(FLASH_TYPEPROGRAM_DOUBLEWORD,ADDR_FLASH_PAGE_62+16,TEMP_buff1[2]);
	
	HAL_FLASH_Lock(); 
}


void bsp_read_ip_config(void )
{
	if( (FLASH_CHECK_NUMMBER_1 == (*(uint8_t *)(ADDR_FLASH_PAGE_62)))  &&
			(FLASH_CHECK_NUMMBER_2 == (*(uint8_t *)(ADDR_FLASH_PAGE_62+1))))
	{
		for(uint8_t i = 0; i < 4; i++)
		{
			ip[i] = (*(uint8_t *)(ADDR_FLASH_PAGE_62+8+i));
			sn[i] = (*(uint8_t *)(ADDR_FLASH_PAGE_62+12+i));
			gw[i] = (*(uint8_t *)(ADDR_FLASH_PAGE_62+16+i));
		}
		g_dhcp_state = (*(uint8_t *)(ADDR_FLASH_PAGE_62+20));
		if(g_dhcp_state != 0xff)
		{
			if(g_dhcp_state == DHCP_ON)
			{
				dhcp = NETINFO_DHCP;
			}
			else
			{
				dhcp = NETINFO_STATIC;
			}
		}
		else
		{
			g_dhcp_state = DHCP_ON;
			dhcp = NETINFO_DHCP;
		}
	}
	else
	{
		g_dhcp_state = DHCP_ON;
		dhcp = NETINFO_DHCP;
		//g_dhcp_state = DHCP_OFF;
		//dhcp = NETINFO_STATIC;
	}
}



void UIDtoMac(void)
{
	uint8_t UID[12];
	//获取单片机唯一UID并设置MAC
	UID[11] = (*(uint8_t*)(0x1FFF7590));
	UID[10] = (*(uint8_t*)(0x1FFF7591));
	UID[9] = (*(uint8_t*)(0x1FFF7592));
	UID[8] = (*(uint8_t*)(0x1FFF7593));
	UID[7] = (*(uint8_t*)(0x1FFF7594));
	UID[6] = (*(uint8_t*)(0x1FFF7595));
	UID[5] = (*(uint8_t*)(0x1FFF7596));
	UID[4] = (*(uint8_t*)(0x1FFF7597));
	UID[3] = (*(uint8_t*)(0x1FFF7598));
	UID[2] = (*(uint8_t*)(0x1FFF7599));
	UID[1] = (*(uint8_t*)(0x1FFF759A));
	UID[0] = (*(uint8_t*)(0x1FFF759B));

	
	mac[0] = 0x00;
	mac[1] = (crc16((uint8_t*)(0x1FFF7590), 12)>>8)&0x00FF;//对UID取正序CRC校验
	mac[2] = (crc16((uint8_t*)(0x1FFF7590), 12))&0x00FF;//对UID取正序CRC校验
	mac[3] = (crc16(UID, 12)>>8)&0x00FF;
	mac[4] = (crc16(UID, 12))&0x00FF;
	mac[5] = UID[0]^UID[1]^UID[2]^UID[3]^UID[4]^UID[5]^UID[6]^UID[7]^UID[8]^UID[9]^UID[10]^UID[11];//BCC校验
	
	DHCP_CHADDR[0] = mac[0];
	DHCP_CHADDR[1] = mac[1];
	DHCP_CHADDR[2] = mac[2];
	DHCP_CHADDR[3] = mac[3];
	DHCP_CHADDR[4] = mac[4];
	DHCP_CHADDR[5] = mac[5];
}
	

