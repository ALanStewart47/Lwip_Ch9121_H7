								temp_udp_sendbuf[0] = 0xF0;
								temp_udp_sendbuf[1] = 0x00;
								send(1,temp_udp_sendbuf,2);	
								
						}
					break;

					case OPT_TCP_FE_CMD_MULTI_SOFT_TRIG :
						
						for (uint8_t i = 0; i < tcp_rec_len - 1 ; i++)
